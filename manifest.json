{
  "manifest_version": 3,
  "name": "Fuzzy Links",
  "version": "2.5.1",
  "description": "Keyboard-first fuzzy navigation with Vim-style page, text, tab, and hint navigation.",
  "permissions": [
    "activeTab",
    "sessions",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
